# syntax=docker/dockerfile:1.7
#
# Shared Go service Dockerfile. Parameterised by SERVICE; the same image
# template builds all 9 backend services. Workspace-aware (uses go.work) so
# the build picks up shared proto/gen modules without retagging.
#
#   docker buildx build \
#     --platform linux/arm64 \
#     --build-arg SERVICE=bot-coordinator \
#     -f infra/docker/Dockerfile.service \
#     -t $REGISTRY/iicpc/bot-coordinator:$TAG \
#     .
#
# Build context MUST be the repo root.

ARG SERVICE

FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG SERVICE
ARG TARGETOS
ARG TARGETARCH

# git is required by `go build` whenever it consults the module cache for
# private modules — even when the workspace `use` directive provides the
# code locally, Go still validates pseudo-versions via git.
RUN apk add --no-cache git ca-certificates

# Build in pure module mode (GOWORK=off). Each service's go.mod carries a
# `replace` for the in-repo proto module pointing at ../../proto/gen/go, so the
# build resolves it from the local filesystem — no go.work, no GITHUB_TOKEN, and
# no attempt to fetch the private pseudo-version. Public deps come from the
# module proxy against each service's complete go.sum.
ENV CGO_ENABLED=0 \
    GOWORK=off \
    GOTOOLCHAIN=auto

WORKDIR /src
COPY proto proto
COPY services services

WORKDIR /src/services/${SERVICE}
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/app .

# ----------------------------------------------------------------------------
# Runtime: distroless static, non-root uid 65532.
# ----------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot
ARG SERVICE
LABEL org.opencontainers.image.title="iicpc/${SERVICE}"
LABEL org.opencontainers.image.source="https://github.com/Ajayendra2705/iicpc-platform"
LABEL org.opencontainers.image.licenses="MIT"

COPY --from=build /out/app /app
USER 65532:65532
ENTRYPOINT ["/app"]
