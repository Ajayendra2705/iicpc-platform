# syntax=docker/dockerfile:1.7
#
# Shared Go service Dockerfile. Parameterised by SERVICE; the same image
# template builds all 9 backend services. Workspace-aware (uses go.work) so
# the build picks up shared proto/gen modules without retagging.
#
#   docker buildx build \
#     --platform linux/arm64 \
#     --build-arg SERVICE=bot-coordinator \
#     -f infra/docker/Dockerfile.service \
#     -t $REGISTRY/iicpc/bot-coordinator:$TAG \
#     .
#
# Build context MUST be the repo root.

ARG SERVICE

FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG SERVICE
ARG TARGETOS
ARG TARGETARCH

# git is required by `go build` whenever it consults the module cache for
# private modules — even when the workspace `use` directive provides the
# code locally, Go still validates pseudo-versions via git.
RUN apk add --no-cache git ca-certificates

ENV CGO_ENABLED=0 \
    GOPRIVATE=github.com/Ajayendra2705 \
    GONOSUMCHECK=github.com/Ajayendra2705 \
    GOTOOLCHAIN=auto

WORKDIR /src
COPY go.work go.work.sum ./
COPY proto proto
COPY samples samples
COPY services services

# Build the target service. The workspace `use ./proto/gen/go` directive
# resolves the private proto module locally, BUT Go still verifies the
# pseudo-version against the remote — for that we mount GITHUB_TOKEN as
# a build secret and rewrite https://github.com/ to inject the token.
# Locally without the secret the fallback no-ops; works for public modules.
WORKDIR /src/services/${SERVICE}
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=secret,id=github_token \
    if [ -s /run/secrets/github_token ]; then \
      git config --global url."https://x-access-token:$(cat /run/secrets/github_token)@github.com/".insteadOf "https://github.com/"; \
    fi && \
    GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /out/app .

# ----------------------------------------------------------------------------
# Runtime: distroless static, non-root uid 65532.
# ----------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot
ARG SERVICE
LABEL org.opencontainers.image.title="iicpc/${SERVICE}"
LABEL org.opencontainers.image.source="https://github.com/Ajayendra2705/iicpc-platform"
LABEL org.opencontainers.image.licenses="MIT"

COPY --from=build /out/app /app
USER 65532:65532
ENTRYPOINT ["/app"]
